{
  "name": "FriCAS",
  "scopeName": "source.fricas",
  "fileTypes": [
    "spad",
    "input",
    "as",
    "boot"
  ],
  "patterns": [
    {
      "include": "#system_command"
    },
    {
      "include": "#comment_block"
    },
    {
      "include": "#comment_docstring"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#function_decl"
    },
    {
      "include": "#type_decl"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#symbol"
    },
    {
      "match": "\\b(category|domain|package|where|with|add|abbrev)\\b",
      "name": "storage.type.primitive.fricas"
    },
    {
      "match": "\\b(if|then|else|case|try|finally|catch|except)\\b",
      "name": "keyword.control.conditional.fricas"
    },
    {
      "match": "\\b(for|in|while|repeat|by)\\b",
      "name": "keyword.control.repeat.fricas"
    },
    {
      "match": "\\b(break|continue|return|yield|iterate|error)\\b",
      "name": "keyword.control.statement.fricas"
    },
    {
      "match": "\\b(and|or|not|has|is)\\b",
      "name": "keyword.operator.logical.fricas"
    },
    {
      "match": "\\b(import|from)\\b",
      "name": "keyword.control.import.fricas"
    },
    {
      "match": "\\b(default|local|define|export|extend|free|fluid|pretend)\\b",
      "name": "keyword.storage.modifier.fricas"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#function_call"
    },
    {
      "include": "#number"
    },
    {
      "include": "#array"
    },
    {
      "include": "#bracket"
    }
  ],
  "repository": {
    "system_command": {
      "patterns": [
        {
          "match": "^\\s*\\)(abbrev|boot|cd|clear|compile|credits|display|edit|fin|frame|help|history|lisp|load|nopretty|packages|pause|pquit|quit|read|savesys|set|show|spool|summary|synonym|system|trace|undo|what|with|jldoc|jlapropos|julia|juliad|)\\b.*$",
          "name": "keyword.other.system-command.fricas"
        }
      ]
    },
    "comment_block": {
      "patterns": [
        {
          "begin": "^\\s*\\)if\\s+false\\b",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.fricas"
            }
          },
          "end": "^\\s*\\)endif\\b",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.fricas"
            }
          },
          "name": "comment.block.fricas"
        }
      ]
    },
    "comment_docstring": {
      "patterns": [
        {
          "begin": "\\+\\+",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.docstring.fricas"
            }
          },
          "end": "$",
          "name": "comment.line.docstring.fricas"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "begin": "--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.fricas"
            }
          },
          "end": "$",
          "name": "comment.line.double-dash.fricas"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.fricas"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.fricas"
            }
          },
          "name": "string.quoted.double.fricas",
          "patterns": [
            {
              "include": "#string_escaped_char"
            }
          ]
        }
      ]
    },
    "string_escaped_char": {
      "patterns": [
        {
          "match": "__",
          "name": "constant.character.escape.fricas"
        },
        {
          "match": "_\"",
          "name": "constant.character.escape.fricas"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "match": "(%(i|pi|e|infinity|plusInfinity|minusInfinity)|\\binfinity\\b)",
          "name": "constant.language.fricas"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.fricas"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "match": "'[a-zA-Z_][a-zA-Z0-9_?!]*",
          "name": "constant.other.symbol.fricas"
        }
      ]
    },
    "function_decl": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.function.macro.fricas"
            }
          },
          "match": "([a-zA-Z_][a-zA-Z0-9_?!]*)(?:\\s*\\([^)]*\\))?\\s*(?===>(?!=))"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.function.fricas"
            }
          },
          "match": "([a-zA-Z_][a-zA-Z0-9_?!]*)(?=\\s*\\([^)]*\\)\\s*(?::\\s*[^=]+)?\\s*==(?!=))"
        }
      ]
    },
    "type_decl": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "entity.name.type.fricas"
            },
            "2": {
              "name": "keyword.operator.relation.types.fricas"
            },
            "3": {
              "name": "support.type.fricas"
            }
          },
          "match": "([A-Z][a-zA-Z0-9_]*)(?:\\s*\\([^)]*\\))?\\s*(:)\\s*(Category|with\\b|[A-Z][a-zA-Z0-9_]*)"
        }
      ]
    },
    "function_call": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "support.function.fricas"
            }
          },
          "match": "([a-zA-Z_][a-zA-Z0-9_?!]*)(?=\\s*\\()"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "==>",
          "name": "keyword.operator.macro.fricas"
        },
        {
          "match": "==",
          "name": "keyword.operator.definition.fricas"
        },
        {
          "match": ":=",
          "name": "keyword.operator.assignment.fricas"
        },
        {
          "match": "\\+->",
          "name": "keyword.operator.arrow.anonymous.fricas"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.type.fricas"
        },
        {
          "match": "::",
          "name": "keyword.operator.coercion.fricas"
        },
        {
          "match": "\\$[A-Z][a-zA-Z0-9_]*|\\$",
          "name": "keyword.operator.package-call.fricas"
        },
        {
          "match": "@",
          "name": "keyword.operator.target-type.fricas"
        },
        {
          "match": "\\.\\.",
          "name": "keyword.operator.range.fricas"
        },
        {
          "match": "(?:<=|>=|~=|<|>|=)",
          "name": "keyword.operator.comparison.fricas"
        },
        {
          "match": "(?:\\+|-|\\*\\*|\\*|/|\\^|\\bquo\\b|\\brem\\b)",
          "name": "keyword.operator.arithmetic.fricas"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b\\d+r[0-9a-zA-Z]+\\b",
          "name": "constant.numeric.radix.fricas"
        },
        {
          "match": "\\b\\d+\\.(?!\\.)\\d*([eE][+-]?\\d+)?(?![a-zA-Z0-9_.])",
          "name": "constant.numeric.float.fricas"
        },
        {
          "match": "(?<![a-zA-Z0-9_.])\\.\\d+([eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.float.fricas"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.fricas"
        }
      ]
    },
    "array": {
      "patterns": [
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "meta.bracket.fricas"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "meta.bracket.fricas"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "bracket": {
      "patterns": [
        {
          "match": "[\\(\\)\\[\\]\\{\\},;]",
          "name": "meta.bracket.fricas"
        }
      ]
    }
  }
}
